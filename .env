# 本项目所有账号密码与环境变量 —— 私有仓库, 明文保存
# 代码统一通过 os.environ 读取, 不在源码里硬编码, 改密码只需改这一处。
#
# 手动生效: set -a; source .env; set +a
# 自动生效: Python 侧由 pipeline/config.py 调 load_dotenv() 自动加载

# ── 同花顺 thsdk 正式账号 (拉1分钟K线/资金流/事件, 仅Windows可用) ──
THS_USERNAME=KQ2026
THS_PASSWORD=lin88888888

# ── 同花顺 Python 解释器路径 (Windows 专用 thsdk 环境) ──
# THS_PYTHON=C:\Users\admin\.workbuddy\binaries\python\envs\ths\Scripts\python.exe

# ── 运行模式: live | backtest ──
QUANT_MODE=backtest

# ── 数据根目录 (留空则用仓库内 data/) ──
